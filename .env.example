# Core API key
GEMINI_API_KEY=

# Comma-separated paths to background footage files
GTA_FOOTAGE_PATHS=/Users/ananthmangalam/Downloads/clip1.mp4,/Users/ananthmangalam/Downloads/clip2.mp4

# TTS and subtitle settings
TTS_VOICE=en-US-ChristopherNeural
STORY_DURATION_SECONDS=55
WORDS_PER_SECOND=2.7
SUBTITLE_CHUNK_WORDS=5
SUBTITLE_FONT_SIZE=70
SUBTITLE_FONT=/System/Library/Fonts/SFNSMono.ttf
SUBTITLE_COLOR=white
SUBTITLE_STROKE_COLOR=black
SUBTITLE_STROKE_WIDTH=3
SUBTITLE_Y_POSITION=0.75

# Entry point / defaults
VIDEO_STYLE=scary
OUTPUT_VIDEO_PATH=
KEEP_OUTPUT_VIDEO=false

# Upload toggles
UPLOAD_TO_YOUTUBE=true
UPLOAD_TO_INSTAGRAM=false
UPLOAD_TO_TIKTOK=false

# YouTube
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=youtube_token.pickle
YOUTUBE_CATEGORY_ID=24

# Instagram
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# TikTok
TIKTOK_ACCESS_TOKEN=

# Optional ImageMagick override
IMAGEMAGICK_BINARY=/opt/homebrew/bin/magick
